# Copy to config/secrets.env or export these variables in your shell.
# Do not commit config/secrets.env.

# Optional Lark/Feishu webhook override.
DAILY_INTEL_LARK_WEBHOOK=

# Optional agent command. Equivalent to runtime.yaml agent_command.
# Examples:
# DAILY_INTEL_AGENT_CMD='claude -p "$(cat {prompt})"'
# DAILY_INTEL_AGENT_CMD='codex exec "$(cat {prompt})"'
DAILY_INTEL_AGENT_CMD=

# Optional future providers.
X_BEARER_TOKEN=
NEWS_API_KEY=
